object ThemedButtonFrame: TThemedButtonFrame
  Left = 0
  Height = 28
  Top = 0
  Width = 100
  ClientHeight = 28
  ClientWidth = 100
  TabStop = True
  object pbFace: TPaintBox
    Left = 0
    Height = 28
    Top = 0
    Width = 100
    Align = alClient
    OnMouseDown = PbFaceMouseDown
    OnMouseMove = PbFaceMouseMove
    OnMouseLeave = PbFaceMouseLeave
    OnMouseUp = PbFaceMouseUp
    OnPaint = PbFacePaint
  end
end
