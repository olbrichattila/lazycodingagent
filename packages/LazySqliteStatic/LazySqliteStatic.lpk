<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="LazySqliteStatic"/>
    <Type Value="RunTimeOnly"/>
    <BuildModes>
      <Item1 Name="Default" Default="True"/>
      <Item2 Name="MingwStaticEmbed">
        <CompilerOptions>
          <Version Value="11"/>
          <OtherDefines Count="1">
            <Item1 Value="LCA_SQLITE_MINGW_EMBED"/>
          </OtherDefines>
        </CompilerOptions>
      </Item2>
      <Item3 Name="MsvcStaticEmbed">
        <CompilerOptions>
          <Version Value="11"/>
          <OtherDefines Count="1">
            <Item1 Value="LCA_SQLITE_EMBED_WIN"/>
          </OtherDefines>
        </CompilerOptions>
      </Item3>
    </BuildModes>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="src"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="Static embedded SQLite amalgamation for LazyCodingAgent"/>
    <Version Major="0" Minor="1" Release="0"/>
    <Files Count="2">
      <Item1>
        <Filename Value="src\LazySqliteStatic.pas"/>
        <UnitName Value="LazySqliteStatic"/>
      </Item1>
      <Item2>
        <Filename Value="src\uSqlite3Embed.pas"/>
        <UnitName Value="uSqlite3Embed"/>
      </Item2>
    </Files>
    <RequiredPkgs Count="1">
      <Item1>
        <PackageName Value="FCL"/>
      </Item1>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
