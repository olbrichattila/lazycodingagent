# Copy to .env before: docker compose up -d
# https://docs.searxng.org/admin/installation-docker.html

# Pin image tag (default: latest). Example: 2026.3.25-541c6c3cb
#SEARXNG_VERSION=latest

# Host bind prefix (optional). Example: [::] or 127.0.0.1
#SEARXNG_HOST=127.0.0.1

# Port exposed on the host (LazyCodingAgent default instance URL uses this port).
SEARXNG_PORT=8080

# Required for current SearXNG images (default "ultrasecretkey" is rejected at startup).
SEARXNG_SECRET=local-dev-only-change-me-before-any-public-use
