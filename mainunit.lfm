        OnClick = MnuViewTerminalClick
      end
      object mnuViewSyntaxSep: TMenuItem
        Caption = '-'
      end
      object mnuViewSyntaxSchemes: TMenuItem
        Caption = 'Syntax Highlighting &Schemes...'
        OnClick = MnuViewSyntaxSchemesClick
      end
      object mnuViewActiveSchemes: TMenuItem
        Caption = 'Active Syntax &Scheme'
      end
    end
    object mnuWorkspace: TMenuItem
      Caption = '&Workspace'
      object mnuWorkspaceSepRules: TMenuItem
        Tag = -1
        Caption = '-'
      end
      object mnuWorkspaceProjectRules: TMenuItem
        Tag = -1
        Caption = 'Project &Rules...'
        OnClick = MnuWorkspaceProjectRulesClick
      end
    end
    object mnuAgent: TMenuItem
      Caption = '&Agent'
      object mnuAgentClearHistory: TMenuItem
        Caption = '&Clear Conversation'
        OnClick = MnuAgentClearHistoryClick
      end
      object mnuAgentStop: TMenuItem
        Caption = '&Stop Active Agent'
        OnClick = MnuAgentStopClick
      end
    end
    object mnuSettings: TMenuItem
      Caption = '&Settings'
      object mnuSettingsOptions: TMenuItem
        Caption = '&Preferences && API Configuration...'
        OnClick = MnuSettingsOptionsClick
      end
    end
    object mnuWindow: TMenuItem
      Caption = '&Window'
      object mnuPanelsVisibility: TMenuItem
        Caption = '&Panels'
      end
    end
    object mnuHelp: TMenuItem
      Caption = '&Help'
      object mnuHelpUserGuide: TMenuItem
        Caption = '&User Guide...'
        ShortCut = 112
        OnClick = MnuHelpUserGuideClick
      end
      object mnuHelpAbout: TMenuItem
        Caption = '&About LazyCodingAgent...'
        OnClick = MnuHelpAboutClick
      end
    end
  end
end