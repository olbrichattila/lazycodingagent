  ClientWidth = 420
  DesignTimePPI = 96
  Font.Name = 'Segoe UI'
  Position = poScreenCenter
  LCLVersion = '4.8.0.0'
  OnCreate = FormCreate
  OnShow = FormShow
  object lblMessage: TLabel
    Left = 16
    Height = 72
    Top = 16
    Width = 388
