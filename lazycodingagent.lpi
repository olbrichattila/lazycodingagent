    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <Libraries Value="packages\LazySqliteStatic\src"/>
      <OtherUnitFiles Value="third_party\fpc-openssl3\src;data;data\sqlite"/>
