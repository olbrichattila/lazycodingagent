object SettingsForm: TSettingsForm
  Left = 350
  Height = 520
  Top = 160
  Width = 560
  BorderStyle = bsDialog
  Caption = 'Settings'
  ClientHeight = 520
  ClientWidth = 560
  OnCreate = FormCreate
  OnShow = FormShow
  Position = poScreenCenter
  LCLVersion = '3.4.0.0'
  object pnlSettingsTabsHost: TPanel
    BevelOuter = bvNone
    Left = 12
    Height = 420
    Top = 12
    Width = 536
    Align = alClient
    BorderSpacing.Left = 12
    BorderSpacing.Top = 12
    BorderSpacing.Right = 12
    BorderSpacing.Bottom = 8
    TabOrder = 0
    object pgcSettings: TPageControl
      Left = 0
      Height = 420
      Top = 0
      Width = 536
      Align = alClient
      TabOrder = 0
      object tsProvider: TTabSheet
        Caption = 'AI Provider & Model'
        object pnlTabProvider: TPanel
          Left = 0
          Height = 392
          Top = 0
          Width = 528
          Align = alClient
          BevelOuter = bvNone
          TabOrder = 0
      object lblProvider: TLabel
        Left = 16
        Height = 15
        Top = 16
        Width = 63
        Caption = 'LLM Provider'
      end
      object cboProvider: TLcaThemedComboBox
        Left = 16
        Height = 25
        Top = 36
        Width = 504
        ItemHeight = 22
        ItemIndex = 0
        Items.Strings = (
          'OpenRouter'
          'OpenAI'
          'Anthropic'
          'Ollama (Local)'
          'Nous Research'
          'Custom / OpenAI Compatible'
        )
        OnChange = cboProviderChange
        Style = csDropDownList
        TabOrder = 0
        Text = 'OpenRouter'
      end
      object lblApiKey: TLabel
        Left = 16
        Height = 15
        Top = 72
        Width = 100
        Caption = 'API Key (or Secret)'
      end
      object edtApiKey: TEdit
        Left = 16
        Height = 23
        Top = 92
        Width = 504
        EchoMode = emPassword
        PasswordChar = '*'
        TabOrder = 1
      end
      object lblBaseUrl: TLabel
        Left = 16
        Height = 15
        Top = 128
        Width = 87
        Caption = 'Base API Endpoint'
      end
      object edtBaseUrl: TEdit
        Left = 16
        Height = 23
        Top = 148
        Width = 504
        TabOrder = 2
        Text = 'https://openrouter.ai/api/v1'
      end
      object lblModels: TLabel
        Left = 16
        Height = 15
        Top = 184
        Width = 196
        Caption = 'Saved models (default = selection)'
      end
      object lstModels: TListBox
        Left = 16
        Height = 120
        Top = 204
        Width = 504
        ItemHeight = 22
        OnDrawItem = lstModelsDrawItem
        OnClick = lstModelsClick
        TabOrder = 3
      end
      object btnFetchModels: TLcaThemedButton
        ButtonRole = tbrPrimary
        Tag = 1
        Left = 16
        Height = 28
        Top = 336
        Width = 120
        Caption = 'Fetch Models...'
        OnClick = btnFetchModelsClick
        TabOrder = 4
      end
      object btnEditModel: TLcaThemedButton
        ButtonRole = tbrCancel
        Left = 144
        Height = 28
        Top = 336
        Width = 88
        Caption = 'Edit...'
        OnClick = btnEditModelClick
        TabOrder = 5
      end
      object btnDeleteModel: TLcaThemedButton
        ButtonRole = tbrDestructive
        Tag = 2
        Left = 240
        Height = 28
        Top = 336
        Width = 88
        Caption = 'Delete'
        OnClick = btnDeleteModelClick
        TabOrder = 6
      end
      object lblNotice: TLabel
        Left = 16
        Height = 30
        Top = 372
        Width = 504
        AutoSize = False
        Caption = 'Note: Your API credentials are saved locally in the user config file.'
        WordWrap = True
      end
        end
      end
      object tsAgent: TTabSheet
        Caption = 'Agent Behavior'
        object pnlTabAgent: TPanel
          Left = 0
          Height = 392
          Top = 0
          Width = 528
          Align = alClient
          BevelOuter = bvNone
          TabOrder = 0
      object lblTemp: TLabel
        Left = 16
        Height = 15
        Top = 16
        Width = 102
        Caption = 'Temperature (0..1)'
      end
      object edtTemp: TEdit
        Left = 16
        Height = 23
        Top = 36
        Width = 200
        TabOrder = 0
        Text = '0.2'
      end
      object lblMaxTokens: TLabel
        Left = 16
        Height = 15
        Top = 76
        Width = 99
        Caption = 'Max Output Tokens'
      end
      object edtMaxTokens: TEdit
        Left = 16
        Height = 23
        Top = 96
        Width = 200
        TabOrder = 1
        Text = '4096'
      end
      object lblMaxSteps: TLabel
        Left = 16
        Height = 15
        Top = 136
        Width = 143
        Caption = 'Max Autonomous Steps/Loop'
      end
      object edtMaxSteps: TEdit
        Left = 16
        Height = 23
        Top = 156
        Width = 200
        TabOrder = 2
        Text = '20'
      end
      object chkDebuggingMode: TCheckBox
        Left = 16
        Height = 19
        Top = 196
        Width = 140
        Caption = 'Debugging Mode'
        TabOrder = 3
      end
      object lblDebuggingHint: TLabel
        Left = 16
        Height = 30
        Top = 220
        Width = 504
        AutoSize = False
        Caption = 'When enabled, full tool results appear in the chat history. When disabled, only tool errors are shown.'
        WordWrap = True
      end
        end
      end
      object tsWorkspace: TTabSheet
        Caption = 'Workspace'
        object pnlTabWorkspace: TPanel
          Left = 0
          Height = 392
          Top = 0
          Width = 528
          Align = alClient
          BevelOuter = bvNone
          TabOrder = 0
      object lblWorkspaceRoot: TLabel
        Left = 16
        Height = 15
        Top = 16
        Width = 127
        Caption = 'Workspace Directory Root'
      end
      object edtWorkspaceRoot: TEdit
        Left = 16
        Height = 23
        Top = 36
        Width = 416
        TabOrder = 0
      end
      object btnBrowseWorkspace: TLcaThemedButton
        ButtonRole = tbrCancel
        Left = 440
        Height = 23
        Top = 36
        Width = 80
        Caption = 'Browse...'
        OnClick = btnBrowseWorkspaceClick
        TabOrder = 1
      end
      object lblWorkspaceName: TLabel
        Left = 16
        Height = 15
        Top = 76
        Width = 91
        Caption = 'Workspace Name'
      end
      object edtWorkspaceName: TEdit
        Left = 16
        Height = 23
        Top = 96
        Width = 504
        TabOrder = 2
        Text = 'LazyCodingAgent'
      end
        end
      end
    end
  end
  object pnlBottom: TPanel
    Left = 0
    Height = 44
    Top = 476
    Width = 560
    Align = alBottom
    BevelOuter = bvNone
    ClientHeight = 44
    ClientWidth = 560
    TabOrder = 1
    object btnOK: TLcaThemedButton
      ButtonRole = tbrPrimary
      Tag = 1
      Left = 376
      Height = 28
      Top = 8
      Width = 80
      Anchors = [akTop, akRight]
      Caption = 'OK'
      OnClick = btnOKClick
      TabOrder = 0
    end
    object btnCancel: TLcaThemedButton
      ButtonRole = tbrCancel
      Left = 464
      Height = 28
      Top = 8
      Width = 80
      Anchors = [akTop, akRight]
      Caption = 'Cancel'
      OnClick = btnCancelClick
      TabOrder = 1
    end
  end
end